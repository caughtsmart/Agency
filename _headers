/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://*.googletagmanager.com; connect-src 'self' https://cloudflareinsights.com https://static.cloudflareinsights.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; upgrade-insecure-requests

# Notes on the CSP above:
#
# 'unsafe-inline' is present for script-src and style-src on purpose. The site is
# a single self-contained HTML file with its CSS and JS inline, which is the whole
# point — Graham can open it in a text editor and change it without a build step.
# Hashes would be stricter but would silently break the page every time a character
# changes. Given the page has no user-generated content, no third-party scripts and
# no cookies or auth to steal, the residual XSS risk is close to nil.
#
# Fonts are self-hosted under /fonts/, so font-src is 'self' and no Google
# domains appear anywhere.
#
# script-src and connect-src allow Cloudflare Web Analytics (the beacon script
# and its report endpoint). Remove them if you don't turn analytics on.
#
# The googletagmanager and google-analytics origins are for GA4. Without them
# the tag in index.html is blocked by this header and reports nothing at all,
# with no error anywhere except the browser console — so if analytics ever goes
# quiet, check here first. The wildcards are the set Google documents; GA4
# resolves to regional subdomains (region1.google-analytics.com and friends)
# that can't be listed exhaustively.

# Static assets can be cached hard. The fonts are immutable — replace the file
# name if you ever change them.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/og.png
  Cache-Control: public, max-age=604800

/graham.jpg
  Cache-Control: public, max-age=604800

/graham-hero.jpg
  Cache-Control: public, max-age=604800

/graham-worn.jpg
  Cache-Control: public, max-age=604800

/board-wash.jpg
  Cache-Control: public, max-age=604800

/warehouse-trays.jpg
  Cache-Control: public, max-age=604800

# Cloudflare Pages serves pages extensionless (/privacy, not /privacy.html) and
# 308-redirects the .html form — so header rules must use the extensionless
# paths or they match only the redirect, not the page.
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# The thank-you page is kept out of search for two reasons: it reads as a
# mistake in a results page, and any visit that arrives from search is a visit
# that never submitted anything — which would quietly inflate the one number
# on this site that is supposed to mean a real lead.
/thanks
  X-Robots-Tag: noindex, nofollow
